{
  "title": "margin",
  "uid": "margin-reader",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests per second, by route and status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(margin_http_requests[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP request latency p95, by route (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(margin_http_request_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Page render time p95 (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(margin_page_render_seconds_bucket[5m])))",
          "legendFormat": "render p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Database queue full (503s answered)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(margin_db_queue_full[5m])",
          "legendFormat": "queue full"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Comments written per minute, by author kind and visibility",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (author_kind, visibility) (increase(margin_comments[1m]))",
          "legendFormat": "{{author_kind}} {{visibility}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Feed wait p50 and p95 (seconds a call was held)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(margin_feed_wait_seconds_bucket[5m])))",
          "legendFormat": "wait p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(margin_feed_wait_seconds_bucket[5m])))",
          "legendFormat": "wait p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Feed lag p95 (seconds from a change to the answer carrying it)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(margin_feed_lag_seconds_bucket[5m])))",
          "legendFormat": "lag p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Age of the last successful backup (seconds; backups run every 900)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "time() - max(margin_backup_last_success_timestamp_seconds)", "legendFormat": "age" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Backup runs by result (per hour)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (sum_over_time(margin_backup_runs[1h]))", "legendFormat": "{{result}}" }
      ]
    }
  ]
}
